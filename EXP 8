#include <stdio.h>

#define INF 99999

struct Edge {
    int u, v, w;
};

int main() {
    struct Edge edge[100];
    int V, E, source;
    int dist[50];
    int i, j;

    printf("Enter number of vertices: ");
    scanf("%d", &V);

    printf("Enter number of edges: ");
    scanf("%d", &E);

    printf("Enter edges (source destination weight):\n");

    for (i = 0; i < E; i++)
        scanf("%d %d %d",
              &edge[i].u,
              &edge[i].v,
              &edge[i].w);

    printf("Enter source vertex: ");
    scanf("%d", &source);

    for (i = 0; i < V; i++)
        dist[i] = INF;

    dist[source] = 0;

    for (i = 1; i <= V - 1; i++) {
        for (j = 0; j < E; j++) {
            int u = edge[j].u;
            int v = edge[j].v;
            int w = edge[j].w;

            if (dist[u] != INF &&
                dist[u] + w < dist[v])
                dist[v] = dist[u] + w;
        }
    }

    for (j = 0; j < E; j++) {
        int u = edge[j].u;
        int v = edge[j].v;
        int w = edge[j].w;

        if (dist[u] != INF &&
            dist[u] + w < dist[v]) {
            printf("Negative weight cycle exists.\n");
            return 0;
        }
    }

    printf("\nShortest distances:\n");

    for (i = 0; i < V; i++)
        printf("%d -> %d = %d\n",
               source, i, dist[i]);

    printf("Time Complexity: O(VE)\n");

    return 0;
}
