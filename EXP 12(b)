#include <stdio.h>

struct Edge {
    int u, v, w;
};

int parent[50];

int find(int i) {
    while (parent[i] != i)
        i = parent[i];

    return i;
}

void unionSet(int i, int j) {
    int a = find(i);
    int b = find(j);

    parent[a] = b;
}

int main() {
    struct Edge e[100], temp;
    int V, E, i, j;
    int count = 0, total = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &V);

    printf("Enter number of edges: ");
    scanf("%d", &E);

    printf("Enter edges (source destination weight):\n");

    for (i = 0; i < E; i++)
        scanf("%d %d %d",
              &e[i].u,
              &e[i].v,
              &e[i].w);

    // Sort edges by weight
    for (i = 0; i < E - 1; i++) {
        for (j = i + 1; j < E; j++) {
            if (e[i].w > e[j].w) {
                temp = e[i];
                e[i] = e[j];
                e[j] = temp;
            }
        }
    }

    for (i = 0; i < V; i++)
        parent[i] = i;

    printf("\nEdges in Minimum Spanning Tree:\n");

    for (i = 0; i < E && count < V - 1; i++) {

        int u = find(e[i].u);
        int v = find(e[i].v);

        if (u != v) {
            printf("%d - %d : %d\n",
                   e[i].u, e[i].v, e[i].w);

            total += e[i].w;
            unionSet(u, v);
            count++;
        }
    }

    printf("Total MST cost = %d\n", total);
    printf("Time Complexity: O(E log E)\n");

    return 0;
}
