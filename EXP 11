#include <stdio.h>

struct Activity {
    int start;
    int finish;
};

int main() {
    struct Activity a[50], temp;
    int n, i, j, last;

    printf("Enter number of activities: ");
    scanf("%d", &n);

    printf("Enter start and finish times:\n");

    for (i = 0; i < n; i++)
        scanf("%d %d", &a[i].start, &a[i].finish);

    // Sort according to finish time
    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (a[i].finish > a[j].finish) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    printf("\nSelected activities:\n");

    printf("(%d, %d)\n", a[0].start, a[0].finish);
    last = a[0].finish;

    for (i = 1; i < n; i++) {
        if (a[i].start >= last) {
            printf("(%d, %d)\n",
                   a[i].start,
                   a[i].finish);

            last = a[i].finish;
        }
    }

    printf("Time Complexity: O(n^2) using sorting\n");

    return 0;
}
